#!/usr/bin/env bash
# Instala ou atualiza o Seletor de Tema e tudo do estilo Apple (macOS).
# Rode como seu usuário, sem sudo: ele pede a senha quando precisa.
#   ~/meus-scripts/bin/instalar-seletor-de-tema
set -e
[ "$EUID" -eq 0 ] && { echo "Rode sem sudo (o yay não roda como root). A senha é pedida quando precisar."; exit 1; }
cd "$(dirname "$(readlink -f "$0")")/.."

echo "==> Copiando o app para o sistema"
sudo install -m 755 bin/seletor-de-tema bin/apply-macos-look.sh bin/aparencia-aplicar-todos /usr/local/bin/
sudo install -Dm 644 icons/seletor-de-tema.svg /usr/share/icons/hicolor/scalable/apps/seletor-de-tema.svg
sudo install -m 644 applications/seletor-de-tema.desktop /usr/share/applications/
sudo install -Dm 644 -t /usr/share/backgrounds/seletor-de-tema wallpapers/claro.jpg wallpapers/escuro.jpg
sudo gtk-update-icon-cache -q /usr/share/icons/hicolor || true
sudo update-desktop-database -q /usr/share/applications || true
# Cópias de teste no usuário não são mais necessárias (o sistema já tem as versões novas)
rm -f "$HOME/.local/share/applications/seletor-de-tema.desktop" \
      "$HOME/.local/share/icons/hicolor/scalable/apps/seletor-de-tema.svg"

echo "==> Instalando pacotes e extensões do estilo Apple"
/usr/local/bin/apply-macos-look.sh

echo "==> Deixando apps Flatpak lerem as cores dos botões e o ponteiro"
flatpak override --user --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-config/gtk-3.0:ro \
  --filesystem=xdg-data/icons:ro 2>/dev/null || true

echo "==> Aplicando o tema"
# Mantém claro/escuro atual e liga o estilo Apple
if [ "$(gsettings get org.gnome.desktop.interface color-scheme)" = "'prefer-dark'" ]; then
  /usr/local/bin/seletor-de-tema --tema apple-dark
else
  /usr/local/bin/seletor-de-tema --tema apple-light
fi
echo
echo "Tudo pronto. Saia e entre na sessão uma vez para o vidro e o efeito de minimizar."
echo "Para voltar ao GNOME padrão, use o app Seletor de Tema."
