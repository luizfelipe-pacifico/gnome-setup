    ("ponteiro", lambda: icon_dir(CURSOR)),
    ("ícones de apps", lambda: icon_dir(ICONS)),
    ("fonte Inter", font_installed),
    ("efeito de minimizar", lambda: ext_dir(LAMP_EXT)),
]


def missing_components():
    return [name for name, ok in COMPONENTS if not ok()]

THEMES = {
    "apple-dark": {"title": "Apple escuro", "dark": True, "apple": True},
    "apple-light": {"title": "Apple claro", "dark": False, "apple": True},
    "gnome-dark": {"title": "GNOME escuro", "dark": True, "apple": False},
    "gnome-light": {"title": "GNOME claro", "dark": False, "apple": False},
}

GLASS_PARTS = [
    ("panel", "Barra superior", "view-continuous-symbolic"),
    ("dash-to-dock", "Dock", "view-app-grid-symbolic"),
    ("overview", "Tela de apps", "view-grid-symbolic"),
