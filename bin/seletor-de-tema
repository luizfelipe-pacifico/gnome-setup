    ("org.gnome.desktop.background", "picture-uri-dark", "s",
     lambda d: f"file://{WALLPAPER_DIR}/escuro.jpg", {"need": lambda: os.path.isdir(WALLPAPER_DIR)}),
    ("org.gnome.desktop.screensaver", "picture-uri", "s",
