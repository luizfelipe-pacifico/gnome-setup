#!/usr/bin/env bash
# Grava a aparência como padrão do sistema (todos os usuários e a tela de login) via dconf.
# Roda como root (pkexec).
# Uso: aparencia-aplicar-todos <dark|light> <apple|gnome> <partes-com-vidro separadas por vírgula>
set -e
case "$1" in dark) SCHEME=prefer-dark ;; light) SCHEME=default ;; *) echo "modo inválido" >&2; exit 1 ;; esac
case "$2" in apple|gnome) ;; *) echo "estilo inválido" >&2; exit 1 ;; esac
[[ "$3" =~ ^[a-z,-]*$ ]] || { echo "partes inválidas" >&2; exit 1; }

# Sem este perfil o GNOME não lê os padrões do sistema (não apaga um que já exista)
mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
[ -f /etc/dconf/profile/user ] || printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
grep -q '^system-db:local' /etc/dconf/profile/user || echo 'system-db:local' >> /etc/dconf/profile/user

F=/etc/dconf/db/local.d/00-aparencia
{
  echo "[org/gnome/desktop/interface]"
  echo "color-scheme='$SCHEME'"
  if [ "$2" = apple ]; then
    # Ponteiro, ícones e fonte só se estiverem instalados para o sistema
    [ -d /usr/share/icons/macOS/cursors ] && echo "cursor-theme='macOS'"
    if [ -d /usr/local/share/icons/MacApps ]; then
      if [ "$1" = dark ] && [ -d /usr/local/share/icons/MacApps-dark ]; then echo "icon-theme='MacApps-dark'"
      else echo "icon-theme='MacApps'"; fi
    fi
    if fc-list : family | grep -q '^Inter Variable'; then
      echo "font-name='Inter Variable 11'"
      echo "document-font-name='Inter Variable 11'"
    fi
    echo "clock-show-weekday=true"
    echo "enable-hot-corners=false"
    echo
    echo "[org/gnome/desktop/wm/preferences]"
    echo "button-layout='close,minimize,maximize:'"
    fc-list : family | grep -q '^Inter Variable' && echo "titlebar-font='Inter Variable Semi-Bold 11'"
    echo
    echo "[org/gnome/mutter]"
    echo "center-new-windows=true"
  fi
  echo
  echo "[org/gnome/shell]"
  # Dock, menu do pé do GNOME (com o Aparência…) e seleção limpa sempre; vidro e efeito de
  # minimizar só no estilo Apple
  BASE="'dash-to-dock@micxgx.gmail.com', 'kiwimenu@kemma', 'selecao-limpa@gnome-setup'"
  if [ "$2" = apple ]; then
    echo "enabled-extensions=[$BASE, 'blur-my-shell@aunetx', 'compiz-alike-magic-lamp-effect@hermes83.github.com']"
  else echo "enabled-extensions=[$BASE]"; fi
  echo
  echo "[org/gnome/shell/extensions/kiwimenu]"
  echo "custom-menu-enabled=true"
  echo "custom-menu-label='Aparência…'"
  echo "custom-menu-command='/usr/local/bin/seletor-de-tema'"
  echo "custom-menu-icon='/usr/local/share/icons/hicolor/scalable/apps/seletor-de-tema.svg'"
  for p in panel dash-to-dock overview appfolder lockscreen; do
    echo
    echo "[org/gnome/shell/extensions/blur-my-shell/$p]"
    [[ ",$3," == *",$p,"* ]] && echo "blur=true" || echo "blur=false"
  done
  echo
  echo "[org/gnome/shell/extensions/blur-my-shell/overview]"
  echo "style-components=3"
  echo "[org/gnome/shell/extensions/blur-my-shell/appfolder]"
  echo "style-dialogs=3"
} > "$F"
# Tela de login (GDM): mesmo modo claro/escuro, ponteiro, fonte, ícones e relógio.
# O perfil abaixo é o jeito documentado do GNOME de o GDM ler configurações do sistema.
mkdir -p /etc/dconf/db/gdm.d
printf 'user-db:user\nsystem-db:gdm\nfile-db:/usr/share/gdm/greeter-dconf-defaults\n' > /etc/dconf/profile/gdm
sed -n '/^\[org\/gnome\/desktop\/interface\]/,/^$/p' "$F" > /etc/dconf/db/gdm.d/90-aparencia

dconf update
