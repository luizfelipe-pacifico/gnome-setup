# Botões de janela coloridos (semáforo), entre marcadores para não mexer no resto do gtk.css
CSS_BEGIN, CSS_END = "/* seletor-de-tema: início */", "/* seletor-de-tema: fim */"
TRAFFIC_LIGHTS = {"close": "#ff5f57", "minimize": "#febc2e", "maximize": "#28c840"}
GTK4_CSS = "\n".join([
    "windowcontrols { border-spacing: 8px; }",
    "windowcontrols > button { min-width: 14px; min-height: 14px; padding: 0; margin: 0;"
    " background: none; box-shadow: none; }",
    "windowcontrols > button > image { padding: 1px; -gtk-icon-size: 12px; border-radius: 100%;"
    " color: transparent; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12); }",
    *(f"windowcontrols > button.{b} > image {{ background-color: {c}; }}"
      for b, c in TRAFFIC_LIGHTS.items()),
    "windowcontrols:hover > button > image { color: rgba(0, 0, 0, 0.55); }",
    "windowcontrols > button:active > image { filter: brightness(0.8); }",
    "windowcontrols:not(:hover) > button:backdrop > image { background-color: alpha(gray, 0.45); }",
    # Arquivos: barra lateral como a do Finder (itens arredondados, seleção cinza, ícone na cor
    # de destaque) e itens da grade com cantos arredondados
    ".nautilus-window .navigation-sidebar > row { border-radius: 7px; margin: 1px 8px;"
    " min-height: 30px; }",
    ".nautilus-window .navigation-sidebar > row:selected { background-color: alpha(currentColor, 0.12);"
    " color: inherit; }",
    ".nautilus-window .navigation-sidebar > row:selected image { color: @accent_color; }",
    ".nautilus-window gridview > child { border-radius: 10px; }",
])
# Firefox desenha os próprios botões: o userChrome.css pinta só os três, sem mudar mais nada nele
FIREFOX_CSS = "\n".join([
    ".titlebar-buttonbox { gap: 8px !important; margin-inline: 10px !important; }",
    ".titlebar-button { padding: 0 !important; background: none !important; }",
    ".titlebar-button > .toolbarbutton-icon { width: 13px !important; height: 13px !important;"
    " padding: 0 !important; border-radius: 50% !important; list-style-image: none !important;"
    " box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12) !important; }",
    ".titlebar-close > .toolbarbutton-icon { background: #ff5f57 !important; }",
    ".titlebar-min > .toolbarbutton-icon { background: #febc2e !important; }",
    ".titlebar-max > .toolbarbutton-icon, .titlebar-restore > .toolbarbutton-icon"
    " { background: #28c840 !important; }",
    ":root:-moz-window-inactive .titlebar-buttonbox:not(:hover) .toolbarbutton-icon"
    " { background: rgba(128, 128, 128, 0.45) !important; }",
])
FIREFOX_PREF = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
# Só GTK4/libadwaita: apps do GNOME e os meus. Apps GTK3 hoje são quase todos de fora (navegadores,
# editores...) e ficam como são; o None só limpa o bloco que versões antigas puseram lá.
USER_CSS = [(os.path.expanduser("~/.config/gtk-4.0/gtk.css"), GTK4_CSS),
            (os.path.expanduser("~/.config/gtk-3.0/gtk.css"), None)]

# O que o apply-macos-look.sh instala (nome, verificação)
