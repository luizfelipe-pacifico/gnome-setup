                            ("show-mounts", "b", False), ("dash-max-icon-size", "i", 48),
                            ("click-action", "s", "focus-or-previews")]),
    # Busca estilo Spotlight: Super+Espaço abre o Vicinae (sai da troca de teclado)
    ("org.gnome.desktop.wm.keybindings", "switch-input-source", "as", lambda d: ["XF86Keyboard"],
     {"need": vicinae_path}),
    ("org.gnome.settings-daemon.plugins.media-keys.custom-keybinding", "binding", "s",
     lambda d: "<Super>space", {"path": vicinae_path}),
