     {"need": lambda: icon_dir(CURSOR)}),
    ("org.gnome.desktop.interface", "icon-theme", "s", icons_for, {"need": lambda: icon_dir(ICONS)}),
    ("org.gnome.desktop.interface", "font-name", "s", lambda d: f"{FONT} 11", {"need": font_installed}),
    ("org.gnome.desktop.interface", "document-font-name", "s", lambda d: f"{FONT} 11",
     {"need": font_installed}),
    ("org.gnome.desktop.wm.preferences", "titlebar-font", "s", lambda d: f"{FONT} Semi-Bold 11",
     {"need": font_installed}),
    # Barra superior: dia da semana no relógio e sem canto ativo (o Mac não tem por padrão)
    ("org.gnome.desktop.interface", "clock-show-weekday", "b", lambda d: True, {}),
    ("org.gnome.desktop.interface", "clock-show-date", "b", lambda d: True, {}),
    ("org.gnome.desktop.interface", "enable-hot-corners", "b", lambda d: False, {}),
    ("org.gnome.desktop.interface", "accent-color", "s", lambda d: "blue", {}),
    ("org.gnome.shell.extensions.kiwimenu", "macos-accelerators", "b", lambda d: True,
     {"ext": "kiwimenu@kemma"}),
    # Papel de parede claro e escuro
    ("org.gnome.desktop.background", "picture-uri", "s",
