#!/usr/bin/env bash
# Amplia imagens para qualidade 4K (no mínimo 3840×2160, ou 2160×3840 em pé, sem cortar) e salva "nome-4k.jpg"
# ao lado da original, que fica intacta. Aparece em Imagens → menu ☰ → Abrir com… → Upscale 4K
# e no clique direito do Arquivos. Uso: upscale-4k imagem [imagem...]
set -uo pipefail
# UPSCALE_SILENCIOSO=1 (testes): sem notificação e sem abrir o resultado
avisar() { [ -z "${UPSCALE_SILENCIOSO:-}" ] && notify-send -a "Upscale 4K" -i upscale-4k "$@" 2>/dev/null || echo "$*"; }
command -v magick >/dev/null || { avisar "Upscale 4K" "Falta o ImageMagick: sudo pacman -S imagemagick"; exit 1; }
[ $# -gt 0 ] || { echo "Uso: upscale-4k imagem [imagem...]"; exit 1; }

feitos=()
for f in "$@"; do
  f=${f#file://}; f=$(printf '%b' "${f//%/\\x}")   # caminhos vindos como URI
  [ -f "$f" ] || { avisar "Upscale 4K" "Arquivo não encontrado: $f"; continue; }
  read -r w h < <(magick identify -format '%w %h\n' "$f[0]" 2>/dev/null) ||
    { avisar "Upscale 4K" "Não é uma imagem: $(basename "$f")"; continue; }
  if [ $(( w > h ? w : h )) -ge 3840 ] && [ $(( w < h ? w : h )) -ge 2160 ]; then
    avisar "Já está em 4K" "$(basename "$f") tem ${w}×${h}"; continue
  fi
  alvo='3840x2160^'; [ "$h" -gt "$w" ] && alvo='2160x3840^'   # foto em pé: 4K na vertical
  saida="${f%.*}-4k.jpg"
  avisar "Ampliando…" "$(basename "$f") (${w}×${h})"
  # Com a IA (Real-ESRGAN): recria os detalhes e tira o ruído e os quadradinhos do JPEG em uma
  # passada 4×; o resto até o 4K é só redimensionar, sem nitidez extra (nitidez realça ruído).
  # Sem a IA: só redimensiona, com um leve tira-ruído
  tmp=$(mktemp -d)
  modelos=(); for d in /usr/share/realesrgan-ncnn-vulkan/models /opt/realesrgan-ncnn-vulkan/models; do
    [ -d "$d" ] && modelos=(-m "$d"); done
  if command -v realesrgan-ncnn-vulkan >/dev/null &&
     magick "$f[0]" -auto-orient "$tmp/in.png" &&
     realesrgan-ncnn-vulkan -i "$tmp/in.png" -o "$tmp/ia.png" -n realesrgan-x4plus "${modelos[@]}" -t 256 >/dev/null 2>&1; then
    origem="$tmp/ia.png"; limpa=()
  else
    origem="$f[0]"; limpa=(-auto-orient -enhance)
  fi
  if magick "$origem" "${limpa[@]}" -colorspace RGB -filter Lanczos -resize "$alvo" -colorspace sRGB \
       -strip -sampling-factor 4:2:0 -quality 92 "$saida"; then
    feitos+=("$saida")
  else
    avisar "Upscale 4K" "Não deu para ampliar $(basename "$f")"
  fi
  rm -rf "$tmp"
done

[ ${#feitos[@]} -gt 0 ] || exit 1
read -r w h < <(magick identify -format '%w %h\n' "${feitos[-1]}")
avisar "Pronto: ${w}×${h}" "$(basename "${feitos[-1]}")${feitos[1]:+ e mais $(( ${#feitos[@]} - 1 ))}"
[ -n "${UPSCALE_SILENCIOSO:-}" ] || gio open "${feitos[0]}" 2>/dev/null || true
