#!/usr/bin/env bash
# Deixa o que o gnome-setup instala ocupando o mínimo de SSD (roda como root). Não mexe em nada
# que vem com o GNOME ou com o sistema:
#  - pacman não instala as partes repetidas do que colocamos: o ponteiro branco do Mac (usamos o
#    preto) e a coleção fixa da fonte Inter (a versão variável, 1,7 MB, já tem todos os pesos)
#  - cache de pacotes: guarda só a última versão de cada um (para voltar se der erro), como a
#    limpeza semanal já faz
# Uso: sudo enxugar-sistema        (pode rodar de novo quando quiser; só faz o que falta)
set -u
[ "$EUID" -eq 0 ] || { echo "Rode com sudo."; exit 1; }

antes=$(df --output=used -B1M / | tail -1)

# --- NoExtract no pacman.conf (entre marcadores, para atualizar sem duplicar)
PC=/etc/pacman.conf
BLOCO="# gnome-setup: partes repetidas do que o gnome-setup instala
NoExtract = usr/share/icons/macOS-White/* usr/share/fonts/inter/Inter.ttc
# gnome-setup: fim"
sed -i '/^# gnome-setup: /,/^# gnome-setup: fim/d' "$PC"
awk -v bloco="$BLOCO" '{ print } /^\[options\]/ && !feito { print bloco; feito = 1 }' "$PC" > "$PC.novo" &&
  mv "$PC.novo" "$PC"

# --- Apaga o que já estava instalado dessas partes
rm -rf /usr/share/icons/macOS-White
if [ -f /usr/share/fonts/inter/InterVariable.ttf ] && [ -f /usr/share/fonts/inter/Inter.ttc ]; then
  rm -f /usr/share/fonts/inter/Inter.ttc && fc-cache -f /usr/share/fonts/inter
fi

# --- Cache de pacotes
command -v paccache >/dev/null || pacman -S --needed --noconfirm pacman-contrib >/dev/null
paccache -qrk1
paccache -qruk0
rm -rf /var/cache/pacman/pkg/download-* 2>/dev/null

depois=$(df --output=used -B1M / | tail -1)
echo "Pronto: $((antes - depois)) MB liberados."
