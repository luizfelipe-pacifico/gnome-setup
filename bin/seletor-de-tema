def icon_dir(name):
    return next((d for d in (os.path.expanduser(f"~/.local/share/icons/{name}"),
                             f"/usr/local/share/icons/{name}", f"/usr/share/icons/{name}")
                 if os.path.isdir(d)), None)


def ext_dir(uuid):
    return next((f"{d}/{uuid}" for d in EXT_DIRS if os.path.isdir(f"{d}/{uuid}")), None)


def icons_for(dark):
    # No escuro, "MacApps-dark" (lixeira escura); no claro, "MacApps" (lixeira clara)
    return f"{ICONS}-dark" if dark and icon_dir(f"{ICONS}-dark") else ICONS


_font_ok = False


def font_installed():
    global _font_ok  # fc-list é caro: depois de achar a fonte, não pergunta de novo
    _font_ok = _font_ok or FONT in run("fc-list", ":", "family")
    return _font_ok


def vicinae_path():
    """Caminho do atalho personalizado que abre o Vicinae (o "Spotlight")."""
    media = settings("org.gnome.settings-daemon.plugins.media-keys")
    for path in media.get_strv("custom-keybindings") if media else []:
        s = settings("org.gnome.settings-daemon.plugins.media-keys.custom-keybinding", path=path)
        if s and "vicinae" in s.get_string("command"):
            return path
    return None


